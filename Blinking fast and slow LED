  //pinMode(TX_LED,OUTPUT);

}

void loop() {
  // put your main code here, to run repeatedly:
  char i = 0;
  while(i<10)
  {
    digitalWrite(LED_BUILTIN,1);
    delay(100);
    digitalWrite(LED_BUILTIN, 0);
    delay(100);
    i= i+1;
  }// first while loop

